{
  "name": "kima-compliance-os",
  "version": "0.1.0",
  "private": true,
  "description": "KIMA OS — design system and interface prototype",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node scripts/engine-check.mjs && npm run test:phase5 && npm run test:phase7:pilot && node scripts/light-scope-tokens-check.mjs && node --experimental-strip-types --test scripts/fresh-draft-acceptance.test.mjs",
    "test:journey": "node scripts/journey-check.mjs && node scripts/firm-signup-journey-check.mjs && node scripts/contact-inquiry-check.mjs && node scripts/onboarding-firm-optional-check.mjs",
    "test:staff:contract": "node scripts/staff-contract-smoke.mjs",
    "test:staff:screen": "node scripts/staff-screen-smoke.mjs",
    "test:staff:route": "node scripts/staff-route-smoke.mjs",
    "test:staff": "node scripts/firm-staff-check.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "seed:storage": "node scripts/seed-storage.mjs",
    "test:marketing": "node scripts/marketing-consistency-check.mjs",
    "test:portal:firm-scope": "node scripts/portal-firm-scope-check.mjs && node scripts/client-dashboard-session-check.mjs",
    "test:phase3:mocks": "node scripts/phase3-mock-check.mjs",
    "test:phase5": "node scripts/phase5-upload-check.mjs",
    "test:onboarding:firm-optional": "node scripts/onboarding-firm-optional-check.mjs",
    "test:phase7:pilot": "node scripts/phase7-pilot-check.mjs",
    "test:phase7:http": "node scripts/phase7-incident-http-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
