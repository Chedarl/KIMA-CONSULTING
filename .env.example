# KIMA Compliance OS — environment template.
#
# Copy to .env.local and fill in. NEVER commit real values: .env*.local is
# gitignored, this file is not.
#
# For a Claude Code cloud session (claude.ai/code, or the Code tab in the
# Claude mobile app) these do NOT come from this file. Set them on the cloud
# environment instead: claude.ai/code -> environment selector -> Environment
# variables. The repository is cloned fresh for every session, so anything that
# is neither committed nor set on the environment simply is not there.

# --- Supabase (demo project, synthetic data only — risk R-32) ---------------
# Both are read in lib/supabase.ts, which THROWS if either is missing, so the
# app will not run without them. The publishable key is public by design and
# bounded by RLS; it is still kept out of git, because a key in history
# outlives every later decision to rotate it.
# Find them at: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>

# SERVER ONLY. Used to issue OTP codes and mint Auth sessions after verify.
# Never prefix with NEXT_PUBLIC. Find it at: Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Resend (outbound mail: OTP + document inquiries) -----------------------
# SERVER ONLY. Never prefix with NEXT_PUBLIC — that would ship the key to the
# browser. Delivery is restricted to the Resend account owner until a Kima
# domain is verified.
RESEND_API_KEY=<resend-api-key>
KIMA_MAIL_FROM=<verified-sender@domain>

# Demo escape hatch: when Resend is not configured, OTP API routes may return
# the plaintext code in the JSON body so synthetic sign-in still works.
# NEVER set this with real taxpayer data (risk R-32).
KIMA_DEMO_OTP_REVEAL=1
